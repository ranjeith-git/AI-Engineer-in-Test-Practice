# ============================================================
# Copy this file to src/.env and fill in your real values.
# src/.env is gitignored — never commit it.
# ============================================================

# --- Jira (Cloud) ---
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token

# --- GROQ fallback LLM ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Ollama (local, primary) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# --- GROQ model (fallback) ---
# Pick any chat model available to your GROQ key (see https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b

# --- Template (single source of truth for output format) ---
# Path is relative to the project root (Chapter03_Local_TC_Gen/)
TEMPLATE_FILE=templates/test cases creator.md
